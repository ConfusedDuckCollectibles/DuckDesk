{
  "name": "@duck-desk/desktop",
  "version": "0.1.0-alpha.9",
  "description": "Desktop companion for Duck Desk live overlays.",
  "author": "Duck Desk",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build -w @duck-desk/shared && npm run build -w @duck-desk/overlay && npm run build -w @duck-desk/extension && npm run build:renderer && npm run build:main && npm run build:preload && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main.cjs --external:electron",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/preload.cjs --external:electron",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:desktop": "node --import tsx --test src/remote.test.ts src/rehearsal.test.ts src/packs.test.ts src/diagnostics.test.ts src/show-session.test.ts",
    "duckpack": "tsx ../../scripts/duckpack-validate.ts",
    "dist": "npm run build -w @duck-desk/shared && npm run build -w @duck-desk/overlay && npm run build -w @duck-desk/extension && npm run build && electron-builder --mac --dir --arm64",
    "dist:dmg": "npm run build -w @duck-desk/shared && npm run build -w @duck-desk/overlay && npm run build -w @duck-desk/extension && npm run build && electron-builder --mac dmg --arm64",
    "dist:win": "npm run build -w @duck-desk/shared && npm run build -w @duck-desk/overlay && npm run build -w @duck-desk/extension && npm run build && electron-builder --win nsis --x64",
    "capture:readme": "electron ../../scripts/capture-readme-images.mjs"
  },
  "dependencies": {
    "@duck-desk/shared": "file:../../packages/shared",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide": "^1.33.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3",
    "yauzl": "^2.10.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "electron": "38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "tsx": "^4.23.12",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.confusedduckcollectibles.duckdesk",
    "productName": "Duck Desk",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "target": [
        "dir",
        "dmg"
      ],
      "artifactName": "DuckDesk-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DuckDesk-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Duck Desk",
      "uninstallDisplayName": "Duck Desk",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../overlay/dist",
        "to": "overlay"
      },
      {
        "from": "../extension/dist",
        "to": "extension"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": null
  }
}
